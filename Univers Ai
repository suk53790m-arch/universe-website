                      child: ListTile(
                        title: Text(pkg.storeProduct.title),
                        subtitle: Text(pkg.storeProduct.priceString),
                        trailing: Icon(Icons.arrow_forward),
                        onTap: () async {
                          await SubscriptionService.purchase(pkg);
                          Navigator.pop(context);
                        },
                      ),
                    );
                  }),
              ],
            ),
    );
  }
}

