class Message {
  final String text;
  final bool isUser;
  final DateTime timestamp;

  Message({required this.text, required this.isUser})
      : timestamp = DateTime.now();
}
import 'dart:convert';
import 'package:http/http.dart' as http;
import 'package:flutter_dotenv/flutter_dotenv.dart';

class ApiService {
  static String get baseUrl => dotenv.env['API_BASE_URL'] ?? 'http://10.0.2.2:3000';

  // 1. AI Chat
  static Future<String> sendChat(String message, List<Message> history) async {
    final response = await http.post(
      Uri.parse('$baseUrl/api/chat'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({
        'message': message,
        'history': history.map((m) => {
          'role': m.isUser ? 'user' : 'assistant',
          'content': m.text
        }).toList(),
      }),
    );
    if (response.statusCode == 200) {
      return jsonDecode(response.body)['reply'];
    }
    throw Exception('Chat failed');
  }

  // 2. AI Video — task create
  static Future<String> createVideo(String prompt, {int duration = 5}) async {
    final response = await http.post(
      Uri.parse('$baseUrl/api/video'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({'prompt': prompt, 'duration': duration}),
    );
    if (response.statusCode == 200) {
      return jsonDecode(response.body)['taskId'];
    }
    throw Exception('Video creation failed');
  }

  // 3. Video status check
  static Future<Map<String, dynamic>> getVideoStatus(String taskId) async {
    final response = await http.get(Uri.parse('$baseUrl/api/video/status/$taskId'));
    if (response.statusCode == 200) {
      return jsonDecode(response.body);
    }
    throw Exception('Status check failed');
  }

  // 4. AI Agent
  static Future<String> runAgent(String message) async {
    final response = await http.post(
      Uri.parse('$baseUrl/api/agent'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({'message': message}),
    );
    if (response.statusCode == 200) {
      return jsonDecode(response.body)['reply'];
    }
    throw Exception('Agent failed');
  }

  // 5. Image Generation
  static Future<String> generateImage(String prompt) async {
    final response = await http.post(
      Uri.parse('$baseUrl/api/image'),
      headers: {'Content-Type': 'application/json'},
      body: jsonEncode({'prompt': prompt}),
    );
    if (response.statusCode == 200) {
      return jsonDecode(response.body)['imageUrl'];
    }
    throw Exception('Image generation failed');
  }
}

